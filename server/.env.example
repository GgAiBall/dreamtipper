# ==== 服务基础 ====
NODE_ENV=production
PORT=3001
JWT_SECRET=请换成随机长字符串
JWT_EXPIRES_IN=30d
CORS_ORIGIN=*

# ==== 数据库（路子三：Turso 云数据库）====
# 不填这两项时，服务会自动回退到本地文件库 file:./dreamtipper.db（仅适合本地开发）
# 生产必须填，数据才会持久化（Render 免费实例的本地磁盘每次重启都会重置）
TURSO_DATABASE_URL=libsql://你的库名-你的账号.turso.io
TURSO_AUTH_TOKEN=你的-turso-token

# 可选：首次建库时跳过自动生成的随机示例数据
# SKIP_SAMPLE_SEED=true
